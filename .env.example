# AI API (OpenAI compatible)
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-your-api-key"
AI_MODEL="gpt-4o-mini"

# Client / CORS
CLIENT_URL="http://localhost:5173"
