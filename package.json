{
  "name": "hogwarts-simulator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run start:dev -w apps/server",
    "build": "npm run build -w apps/client && npm run build -w apps/server",
    "build:cf-worker": "esbuild apps/api/src/index.ts --bundle --format=esm --target=es2022 --outfile=apps/client/public/_worker.js",
    "build:cf": "npm run build:cf-worker && npm run build -w apps/client",
    "db:migrate": "npm run prisma:migrate -w apps/server",
    "db:seed": "npm run prisma:seed -w apps/server",
    "shop:sync": "npm run shop:sync -w apps/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.3"
  }
}
